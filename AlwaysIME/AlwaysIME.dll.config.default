<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <appSettings>
        <add key="AlwaysIMEMode" value="1" />
        <add key="IsDarkMode" value="off" />
        <add key="ImeOffList" value="cmd,WindowsTerminal" />
        <add key="ImeOffTitle" value="" />
        <add key="PassList" value="ShellExperienceHost" />
        <add key="intervalTime" value="200" />
        <add key="UpdateTag" value="\(?更新\)?" />
        <add key="NoKeyInputTime" value="3" />
        <add key="SuspendFewTime" value="5" />
        <add key="SuspendTime" value="45" />
        <add key="OnActivatedAppList" value="" />
        <add key="OnActivatedAppPath" value="" />
        <add key="OnActivatedArgv" value="" />
        <add key="BackgroundAppList" value="" />
        <add key="BackgroundAppPath" value="" />
        <add key="BackgroundArgv" value="" />
        <add key="DelayBackgroundTime" value="" />
        <add key="Punctuation" value="1,3" />
        <add key="SpaceWidth" value="1,2" />
        <add key="AppExitEnd" value="1" />
        <add key="KeyAssignment" value="1" />
        <add key="MsImeSwitch" value="1" />
    </appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
</configuration>
